{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:capability-registry:capability:1",
  "title": "Capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id", "type", "kind", "domain", "operation", "lifecycle", "version", "status", "protocol", "invocation", "name",
    "description", "examples", "tags", "owner", "inputs", "roles",
    "technologies", "tasks", "risk_tier", "permissions",
    "approval_required", "reviewer", "approved_at", "approval_scope"
  ],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]*$"},
    "type": {"enum": ["skill", "tool", "agent", "workflow"]},
    "kind": {"enum": ["knowledge", "action", "handoff"]},
    "domain": {"type": "string", "minLength": 1},
    "operation": {"enum": ["read", "write", "handoff"]},
    "lifecycle": {"enum": ["active", "deprecated", "retired"]},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+)?$"},
    "status": {"enum": ["draft", "approved"]},
    "protocol": {"enum": ["mcp-resource", "mcp", "a2a", "published_agent", "knowledge", "handoff", "local"]},
    "invocation": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["uri"],
          "properties": {"uri": {"type": "string", "pattern": "^skill://[a-z0-9-]+/SKILL\\.md$"}}
        },
        {
          "type": "object", "additionalProperties": false, "required": ["adapter", "tool"],
          "properties": {
            "adapter": {"enum": ["mcp", "a2a", "published_agent", "knowledge", "handoff", "local"]},
            "tool": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "name": {"type": "string", "minLength": 1},
    "description": {"type": "string", "minLength": 1},
    "examples": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "tags": {"$ref": "#/$defs/strings"},
    "owner": {"type": "string", "minLength": 1},
    "inputs": {"type": ["object", "null"]},
    "roles": {"$ref": "#/$defs/strings"},
    "technologies": {
      "type": "array", "uniqueItems": true,
      "items": {"oneOf": [
        {"type": "string", "minLength": 1},
        {"type": "object", "additionalProperties": false, "required": ["name"],
         "properties": {
           "name": {"type": "string", "minLength": 1},
           "constraint": {"type": "string", "minLength": 1}
         }}
      ]}
    },
    "tasks": {"$ref": "#/$defs/strings"},
    "requires": {"$ref": "#/$defs/strings", "default": []},
    "risk_tier": {"enum": ["general", "privileged", null]},
    "permissions": {"type": ["array", "null"], "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "approval_required": {"type": ["boolean", "null"]},
    "reviewer": {"type": ["string", "null"], "minLength": 1},
    "approved_at": {"type": ["string", "null"], "format": "date-time"},
    "approval_scope": {"enum": ["testbed", null]}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "skill"}}},
      "then": {"properties": {
        "protocol": {"const": "mcp-resource"},
        "inputs": {"type": "null"},
        "operation": {"const": "read"},
        "kind": {"const": "knowledge"},
        "invocation": {"required": ["uri"]}
      }},
      "else": {"properties": {"inputs": {"type": "object"}, "invocation": {"required": ["adapter", "tool"]}}}
    },
    {
      "if": {"properties": {"status": {"const": "approved"}}},
      "then": {"properties": {
        "owner": {"type": "string"},
        "risk_tier": {"enum": ["general", "privileged"]},
        "permissions": {"type": "array"},
        "approval_required": {"type": "boolean"},
        "reviewer": {"type": "string"},
        "approved_at": {"type": "string"},
        "approval_scope": {"const": "testbed"}
      }}
    }
  ]
}
